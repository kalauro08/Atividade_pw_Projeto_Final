# Copie este arquivo para .env ou configure as variaveis no ambiente do servidor.
# Nunca publique o arquivo com SMTP_PASS preenchido.
SMTP_HOST=smtp.seuprovedor.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu-email@exemplo.com
SMTP_PASS=sua-senha-ou-app-password
SMTP_FROM=seu-email@exemplo.com
CONTACT_EMAIL=seu-email@exemplo.com
